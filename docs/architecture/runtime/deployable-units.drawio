<mxfile host="gen"><diagram id="c4-deployables" name="Deployable units"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Knowledge Store: deployable units&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A C4 container view (level 2). Each blue box is one deployable unit (a service SV-NNN, the C4 container) or a managed store, labelled with the solution building block (SBB-NNN) that realises it. Grey boxes are outside the store. Arrows are the contracts between units (CT-NNN) where one exists; the build and provisioning units have no runtime arrows.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1500" height="44" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Operator / evaluator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;applies the module, runs sweeps, scores answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;arcSize=30;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="200" height="70" as="geometry"/></mxCell><mxCell id="curator" value="&lt;b&gt;Curator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;loads documents, publishes the ontology&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;arcSize=30;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="190" height="70" as="geometry"/></mxCell><mxCell id="reader" value="&lt;b&gt;Reader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;asks and reads within scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;arcSize=30;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="host" value="&lt;b&gt;Host website&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;embeds the chat page; CT-011, CT-016&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="200" height="70" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;Knowledge Store on AWS&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot;&gt;one account and region, DN-001; every unit provisioned by SBB-010&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=6 4;strokeWidth=1.3;fontSize=12;fontColor=#444444;align=left;verticalAlign=bottom;spacingLeft=8;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="260" y="180" width="1240" height="760" as="geometry"/></mxCell><mxCell id="g-pipe" value="&lt;b&gt;Ingestion and extraction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SBB-014 on SBB-002&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#B9C6D9;strokeWidth=1;fontSize=11;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;arcSize=4;" vertex="1" parent="1"><mxGeometry x="275" y="390" width="180" height="380" as="geometry"/></mxCell><mxCell id="trig" value="&lt;b&gt;Upload and schedule triggers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: EventBridge, SQS, Pipes, Scheduler, DN-016]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CT-005 · SBB-002&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9AD6;fontColor=#1B2A4A;fontSize=12;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="432" width="130" height="80" as="geometry"/></mxCell><mxCell id="pipe" value="&lt;b&gt;Pipeline (the sweep)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: the pipeline image as an ECS Fargate task, DN-004]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SV-001 · SBB-014 · SBB-002&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="610" width="130" height="120" as="geometry"/></mxCell><mxCell id="g-portal" value="&lt;b&gt;Portal&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot;&gt;SBB-007 Portal on CloudFront, API Gateway, Lambda and DynamoDB; SBB-008 Identity on Cognito&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#B9C6D9;strokeWidth=1;fontSize=11;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;arcSize=4;" vertex="1" parent="1"><mxGeometry x="480" y="200" width="1000" height="150" as="geometry"/></mxCell><mxCell id="page" value="&lt;b&gt;Chat page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: static site on CloudFront, DN-009]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SV-007 · SBB-007&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">