  <diagram id="knowledge-store-aws" name="Knowledge Store on AWS">
    <mxGraphModel dx="1600" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1010" background="#FFFFFF" math="0" shadow="0">
