        <mxCell id="v2" value="Knowledge Store on AWS: minimal GraphRAG" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1D2129;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1500" height="34" as="geometry"/></mxCell>
        <mxCell id="v3" value="Ingestion fills a knowledge graph and a passage index; chat answers from both, and every claim shown is checked against a cited passage." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#505663;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="22" as="geometry"/></mxCell>
