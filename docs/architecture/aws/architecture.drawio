        <mxCell id="v5" value="INGESTION" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#7A8190;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="102" width="412" height="20" as="geometry"/></mxCell>
