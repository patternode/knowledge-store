        <mxCell id="v7" value="SHARED: GRAPH, PASSAGES, MODELS" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#7A8190;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="562" y="102" width="396" height="20" as="geometry"/></mxCell>
        <mxCell id="v8" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;fillColor=#F7F8FA;strokeColor=#DDE1E7;html=1;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1068" y="96" width="504" height="736" as="geometry"/></mxCell>
        <mxCell id="v9" value="CHAT" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#7A8190;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1082" y="102" width="476" height="20" as="geometry"/></mxCell>
        <mxCell id="v10" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#2E8B7A&quot;&gt;&lt;b&gt;Amazon S3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Lake: landing/&amp;lt;collection&amp;gt;/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Uploads, parsed text, passages, gold RDF,&lt;br&gt;ontology versions&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#2E8B7A;strokeWidth=1.6;fontColor=#14463D;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="v11" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#3B6FC9&quot;&gt;&lt;b&gt;Amazon ECS Fargate · public subnets, no NAT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;The sweep (idempotent)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EFFB;strokeColor=#3B6FC9;strokeWidth=1.6;fontColor=#1B3566;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="400" height="546" as="geometry"/></mxCell>
        <mxCell id="e12" value="upload event or schedule&lt;br&gt;EventBridge · SQS · Pipes · Scheduler" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v13" value="ingest" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="v14" value="refine" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="336" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="v15" value="Ontology, one of two ways:" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1B3566;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="374" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="v16" value="discover" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="v17" value="review" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="400" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="v18" value="publish" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="100" height="24" as="geometry"/></mxCell>
        <mxCell id="v19" value="or the one you provide (ontology_dir),&lt;br&gt;published by its owl:versionInfo" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1B3566;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="436" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="v20" value="extract (SHACL)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="v21" value="project" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FC9;strokeWidth=1.2;fontColor=#1B3566;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="486" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="e22" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3B6FC9;strokeWidth=1.4;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3B6FC9;strokeWidth=1.4;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3B6FC9;strokeWidth=1.4;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3B6FC9;strokeWidth=1.4;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;" edge="1" parent="1" source="v20" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v26" value="Images for the pipeline and the agent are&lt;br&gt;built in your account by CodeBuild into ECR." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1B3566;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="534" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="v27" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#7B4FC9&quot;&gt;&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Models and screening&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Claude: discovery, review, extraction,&lt;br&gt;and the chat agent&lt;br&gt;Titan Text Embeddings V2: passages&lt;br&gt;Guardrails: questions and grounding&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F1EAFB;strokeColor=#7B4FC9;strokeWidth=1.6;fontColor=#3B2366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="572" y="140" width="376" height="150" as="geometry"/></mxCell>
        <mxCell id="v28" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=none;strokeColor=#8A919E;strokeWidth=1.4;dashed=1;dashPattern=7 5;html=1;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="352" width="400" height="318" as="geometry"/></mxCell>
        <mxCell id="v29" value="VPC · PRIVATE SUBNETS · NO ROUTE OUT" style="text;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#5A6170;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="574" y="358" width="380" height="20" as="geometry"/></mxCell>
        <mxCell id="v30" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#2E8B7A&quot;&gt;&lt;b&gt;Amazon Neptune · SPARQL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Knowledge graph&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Gold RDF: one named graph per document,&lt;br&gt;plus the ontology itself · IAM auth&lt;br&gt;db.t3.medium ≈ 60 USD/month (can be off)&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#2E8B7A;strokeWidth=1.6;fontColor=#14463D;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="386" width="360" height="112" as="geometry"/></mxCell>
        <mxCell id="v31" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#3B6FC9&quot;&gt;&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Graph tools&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Fixed, read-only SPARQL built from&lt;br&gt;the ontology: entities, facts, paths&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EFFB;strokeColor=#3B6FC9;strokeWidth=1.6;fontColor=#1B3566;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="360" height="95" as="geometry"/></mxCell>
        <mxCell id="e32" value="read-only" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;" edge="1" parent="1" source="v31" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v33" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#2E8B7A&quot;&gt;&lt;b&gt;Bedrock Knowledge Base · S3 Vectors&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Passage index&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;One vector per passage, so a hit is&lt;br&gt;a passage id · filtered to collection&lt;br&gt;and the caller's scope&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#2E8B7A;strokeWidth=1.6;fontColor=#14463D;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="572" y="704" width="376" height="112" as="geometry"/></mxCell>
        <mxCell id="e34" value="model calls" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=1;exitY=0.055;exitDx=0;exitDy=0;entryX=0;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="gold RDF" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=1;exitY=0.31;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="every passage" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=1;exitY=0.91;exitDx=0;exitDy=0;entryX=0;entryY=0.57;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v37" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;A person&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;asks in the chat page&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555B66;strokeWidth=1.6;fontColor=#22262E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="132" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="v38" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#C98A2E&quot;&gt;&lt;b&gt;Amazon Cognito · or site_sign_in&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Sign-in&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Cognito (private-readers), or&lt;br&gt;a host website's grant&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FDF1E2;strokeColor=#C98A2E;strokeWidth=1.6;fontColor=#5C3D0F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1336" y="132" width="220" height="88" as="geometry"/></mxCell>
        <mxCell id="e39" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="v37" target="v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v40" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#C98A2E&quot;&gt;&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Chat and ontology pages (static, from S3)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FDF1E2;strokeColor=#C98A2E;strokeWidth=1.6;fontColor=#5C3D0F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="226" width="472" height="66" as="geometry"/></mxCell>
        <mxCell id="e41" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.233;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v37" target="v40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v42" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#3B6FC9&quot;&gt;&lt;b&gt;API Gateway · Lambda · DynamoDB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Chat API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Token or website grant checked · daily quota (30) · concurrency (20)&lt;br&gt;asks the agent as the person, or as a service client by scope&lt;br&gt;conversation and quota state in DynamoDB&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EFFB;strokeColor=#3B6FC9;strokeWidth=1.6;fontColor=#1B3566;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="324" width="472" height="112" as="geometry"/></mxCell>
        <mxCell id="e43" value="/api/*" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0.233;exitY=1;exitDx=0;exitDy=0;entryX=0.233;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v40" target="v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v44" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#7B4FC9&quot;&gt;&lt;b&gt;Amazon Bedrock AgentCore Runtime&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;The chat agent&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Released ontology in its system prompt&lt;br&gt;Answers as claims, each citing a passage + quote&lt;br&gt;Code checks every citation; failed claims removed&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F1EAFB;strokeColor=#7B4FC9;strokeWidth=1.6;fontColor=#3B2366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="460" width="472" height="112" as="geometry"/></mxCell>
        <mxCell id="e45" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0.233;exitY=1;exitDx=0;exitDy=0;entryX=0.233;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v42" target="v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e46" value="model, guardrail" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0;exitY=0.357;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="v44" target="v27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="500"/><mxPoint x="1010" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="v47" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#3B6FC9&quot;&gt;&lt;b&gt;AgentCore Gateway (MCP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Tool gateway&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Interceptor writes the caller's scope into every&lt;br&gt;call from the verified token&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EFFB;strokeColor=#3B6FC9;strokeWidth=1.6;fontColor=#1B3566;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="600" width="472" height="95" as="geometry"/></mxCell>
        <mxCell id="e48" value="MCP, as the caller" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0.233;exitY=1;exitDx=0;exitDy=0;entryX=0.233;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v44" target="v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e49" value="graph tools" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0;exitY=0.316;exitDx=0;exitDy=0;entryX=1;entryY=0.737;entryDx=0;entryDy=0;" edge="1" parent="1" source="v47" target="v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v50" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#3B6FC9&quot;&gt;&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Passage tools&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Search by meaning, then read passages&lt;br&gt;from the lake · outside the VPC&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EFFB;strokeColor=#3B6FC9;strokeWidth=1.6;fontColor=#1B3566;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1084" y="720" width="472" height="96" as="geometry"/></mxCell>
        <mxCell id="e51" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0.233;exitY=1;exitDx=0;exitDy=0;entryX=0.233;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v47" target="v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e52" value="Retrieve" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A505C;strokeWidth=1.8;fontSize=12;fontColor=#3A3F48;labelBackgroundColor=#F7F8FA;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.571;entryDx=0;entryDy=0;" edge="1" parent="1" source="v50" target="v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v53" value="Grounding" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#1D2129;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="32" y="850" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="v54" value="No statement without a source: a claim survives only if its quote is&lt;br&gt;in a passage the caller may read, is ≥ 12 characters, and the&lt;br&gt;guardrail scores it grounded. One repair turn, then it is removed." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#3A3F48;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="32" y="872" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="v55" value="Valves" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#1D2129;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="552" y="850" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="v56" value="Per question: 16 tool calls, 14 model calls, 4000 output tokens&lt;br&gt;per call, 1 repair turn. Optional monthly budget alert." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#3A3F48;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="552" y="872" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="v57" value="Sign-in, networking and cost" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#1D2129;align=left;verticalAlign=top;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1072" y="850" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="v58" value="Cognito, or a host website that frames the pages (site_sign_in).&lt;br&gt;No NAT gateway; Neptune and the graph tools reach S3 through a&lt;br&gt;gateway endpoint. Neptune is the main fixed cost (can be off)." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#3A3F48;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1072" y="872" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="v59" value="Design: docs/architectures/aws.md · Terraform: infra/modules/knowledge-store · Deployment guide: docs/deploy/aws · Generated by architecture_drawio.py" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#7A8190;align=left;verticalAlign=top;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="28" y="976" width="1540" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
