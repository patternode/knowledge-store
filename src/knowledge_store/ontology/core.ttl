@prefix ks:   <https://w3id.org/knowledge-store/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# -----------------------------------------------------------------------------
# Knowledge Store core vocabulary.
#
# Fixed by the lab and shared by every deployment: where a fact came from, never what
# it is about. Domain ontologies are separate files (discovered or authored) and never
# redefine these terms.
# -----------------------------------------------------------------------------

<https://w3id.org/knowledge-store/core>
    a owl:Ontology ;
    rdfs:label "Knowledge Store core vocabulary"@en ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://w3id.org/knowledge-store/core/1.0.0> ;
    rdfs:seeAlso <https://github.com/patternode/knowledge-store/blob/main/docs/core-vocabulary.md> .

ks:Document a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Document"@en ;
    rdfs:comment "One distinct piece of content, identified by the sha256 of its bytes."@en .

ks:Passage a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Passage"@en ;
    rdfs:comment "A deterministic chunk of a document: the unit a fact cites."@en .

ks:ExtractionRun a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Extraction run"@en ;
    rdfs:comment "One pass of a model over documents against one ontology version."@en .

ks:Assertion a owl:Class ;
    rdfs:subClassOf rdf:Statement ;
    rdfs:label "Assertion"@en ;
    rdfs:comment "A reified attribute or relation, carrying the passages it is stated in and the run that extracted it."@en .

ks:partOf a owl:ObjectProperty ; rdfs:domain ks:Passage ; rdfs:range ks:Document .
ks:mentionedIn a owl:ObjectProperty ; rdfs:range ks:Passage ;
    rdfs:comment "An entity is named in this passage."@en .
ks:extractedFrom a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:domain ks:Assertion ; rdfs:range ks:Passage .
ks:extractedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasGeneratedBy ; rdfs:range ks:ExtractionRun .
ks:document a owl:ObjectProperty ; rdfs:range ks:Document .

ks:source a owl:DatatypeProperty ; rdfs:domain ks:Document ; rdfs:range xsd:string .
ks:scope a owl:DatatypeProperty ; rdfs:domain ks:Document ; rdfs:range xsd:string ;
    rdfs:comment "public or private: private documents' facts are served to private-scope users only."@en .
ks:seq a owl:DatatypeProperty ; rdfs:domain ks:Passage ; rdfs:range xsd:integer .
ks:contentHash a owl:DatatypeProperty ; rdfs:range xsd:string .
ks:modelId a owl:DatatypeProperty ; rdfs:domain ks:ExtractionRun ; rdfs:range xsd:string .
ks:promptVersion a owl:DatatypeProperty ; rdfs:domain ks:ExtractionRun ; rdfs:range xsd:string .
ks:ontologyVersion a owl:DatatypeProperty ; rdfs:range xsd:string .
ks:delta a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "The run extracted only the terms an ontology version added, over facts already held."@en .
