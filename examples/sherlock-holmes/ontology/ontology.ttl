@prefix o:    <https://example.org/holmes#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/holmes> a owl:Ontology ;
    rdfs:label "Sherlock Holmes stories"@en ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://example.org/holmes/1.0.0> ;
    rdfs:comment "A small ontology for the Holmes sample: stories as documents, a catalog of the same stories as tables."@en .

o:Story a owl:Class ;
    rdfs:label "Story"@en ;
    skos:definition "One Sherlock Holmes short story."@en .

o:StrandIssue a owl:Class ;
    rdfs:label "Strand issue"@en ;
    skos:definition "One monthly issue of The Strand Magazine."@en .

o:publishedIn a owl:ObjectProperty ;
    rdfs:label "publishedIn"@en ;
    skos:definition "The magazine issue in which a story first appeared."@en ;
    rdfs:domain o:Story ;
    rdfs:range o:StrandIssue .

o:title a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    skos:definition "The story's title."@en ;
    rdfs:domain o:Story ;
    rdfs:range xsd:string .

o:storyId a owl:DatatypeProperty ;
    rdfs:label "storyId"@en ;
    skos:definition "Stable id of a story, also the key of its catalog row."@en ;
    rdfs:domain o:Story ;
    rdfs:range xsd:string .

o:collection a owl:DatatypeProperty ;
    rdfs:label "collection"@en ;
    skos:definition "Which book the story was collected in."@en ;
    rdfs:domain o:Story ;
    rdfs:range xsd:string .

o:client a owl:DatatypeProperty ;
    rdfs:label "client"@en ;
    skos:definition "The person the catalog records as bringing the case. The story text is where that person is described."@en ;
    rdfs:domain o:Story ;
    rdfs:range xsd:string .

o:crime a owl:DatatypeProperty ;
    rdfs:label "crime"@en ;
    skos:definition "A short catalog label for what the case is about."@en ;
    rdfs:domain o:Story ;
    rdfs:range xsd:string .

o:issueId a owl:DatatypeProperty ;
    rdfs:label "issueId"@en ;
    skos:definition "Year and month of a Strand issue, YYYY-MM."@en ;
    rdfs:domain o:StrandIssue ;
    rdfs:range xsd:string .

o:year a owl:DatatypeProperty ;
    rdfs:label "year"@en ;
    skos:definition "The calendar year of an issue."@en ;
    rdfs:domain o:StrandIssue ;
    rdfs:range xsd:integer .

o:month a owl:DatatypeProperty ;
    rdfs:label "month"@en ;
    skos:definition "The calendar month of an issue, 1 to 12."@en ;
    rdfs:domain o:StrandIssue ;
    rdfs:range xsd:integer .

o:magazine a owl:DatatypeProperty ;
    rdfs:label "magazine"@en ;
    skos:definition "The magazine an issue belongs to."@en ;
    rdfs:domain o:StrandIssue ;
    rdfs:range xsd:string .
