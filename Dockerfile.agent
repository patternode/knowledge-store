# The chat agent for AgentCore Runtime, which runs linux/arm64 containers serving
# POST /invocations and GET /ping on port 8080. Built by CodeBuild in the deploying account
# (infra/modules/image-build).
# Pinned to the multi-arch index digest of python:3.12-slim (amd64 and arm64) so that a build
# pulls exactly the image that was reviewed. Update the tag and the digest together.
FROM public.ecr.aws/docker/library/python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DOCKER_CONTAINER=1 PYTHONPATH=/app/src
RUN useradd --create-home --uid 1000 agent
WORKDIR /app
RUN pip install "boto3>=1.40" "strands-agents>=1.50" "bedrock-agentcore>=1.20" "mcp>=1.20,<2" "pydantic>=2" \
    "aws-opentelemetry-distro>=0.10"
COPY src ./src
USER agent
EXPOSE 8080
# opentelemetry-instrument sends traces to AgentCore Observability (CloudWatch).
CMD ["opentelemetry-instrument", "python", "-m", "knowledge_store.answering.adapters.agent_app"]
